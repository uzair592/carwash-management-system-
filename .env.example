# Server Environment Configuration
PORT=5000
NODE_ENV=development
# Leave blank to generate a private installation key. If set, use 32+ random characters.
JWT_SECRET=

# PostgreSQL Database (Local)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=carwash_db
DB_USER=carwash_admin
DB_PASSWORD=local_secure_pass
DATABASE_URL="postgresql://carwash_admin:local_secure_pass@127.0.0.1:5432/carwash_db?schema=public"

# Transparency Engine - Telegram Bot API (Zero Cloud Cost)
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_PARTNER_CHAT_ID=-1001234567890

# Transparency Engine - Local Android SMS Gateway (LAN HTTP Bridge)
ANDROID_SMS_GATEWAY_URL=http://192.168.1.50:8080/send
ANDROID_SMS_API_KEY=local_sms_secret_token_123
PARTNER_SMS_RECIPIENTS=+923001234567,+923009876543

# Hardware Bridge - Hikvision NVR (LAN)
HIKVISION_NVR_IP=192.168.1.64
HIKVISION_NVR_PORT=80
HIKVISION_NVR_USER=admin
HIKVISION_NVR_PASSWORD=SecureCameraPass123
HIKVISION_INGRESS_RTSP_STREAM=rtsp://admin:SecureCameraPass123@192.168.1.64:554/Streaming/Channels/102

# Hardware Bridge - Ingress Grace Period (Seconds)
INGRESS_AUDIT_GRACE_SECONDS=180

# Receipt Printing (ESC/POS)
PRINTER_TYPE=NETWORK
PRINTER_IP=192.168.1.200
PRINTER_PORT=9100

# First-time local owner setup; existing data is preserved by the seed.
SHOP_ADMIN_NAME=Shop Owner
SHOP_ADMIN_PASSWORD=
SHOP_ADMIN_PIN=

# Nightly backup destinations (choose separate physical drives on Windows).
BACKUP_PRIMARY_DIR=
BACKUP_SECONDARY_DIR=
# Optional full paths to PostgreSQL tools when they are not in PATH.
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
# Optional custom directory for the generated installation signing key.
PRIVATE_DATA_DIR=

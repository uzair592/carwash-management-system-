// Prisma Schema for Car Wash & Detailing Management System
// Target Database: PostgreSQL (Local-First ACID Relational Storage)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  Admin
  Manager
  Cashier
  Worker
}

enum ServiceCategory {
  Wash
  Detailing
  PPF
}

enum JobCardStatus {
  QUEUED
  IN_PROGRESS
  READY_FOR_BILLING
  COMPLETED
  Intake
  In_Progress
  Completed
}

enum WorkLocation {
  JACK_1
  JACK_2
  DETAILING_CENTER
  DETAILING_BAY_1
  DETAILING_BAY_2
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

enum RegisterStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  Cash
  Card
  Bank
}

enum DepositStatus {
  ACTIVE
  APPLIED
  REFUNDED
}

enum PartnerTxType {
  CAPITAL_INVESTMENT
  LOAN
  DRAWING
  DIVIDEND_PAYOUT
}

enum UnitType {
  Roll
  ML
  Unit
  PIECE
}

enum AccountType {
  Cash_Drawer
  Main_Bank
}

enum VehicleMediaType {
  BEFORE
  AFTER
  DAMAGE_PROOF
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique // e.g., "ENABLE_SMS_GATEWAY", "ENABLE_CAMERA_ANPR", "ENABLE_TELEGRAM_ALERTS"
  value     Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model User {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(100)
  role            UserRole @default(Worker)
  pin_code        String   @db.VarChar(255)
  password_hash   String?  @db.VarChar(255)
  commission_rate Decimal  @default(0.00) @db.Decimal(5, 2)
  flat_commission Decimal  @default(0.00) @db.Decimal(10, 2)
  base_salary     Decimal  @default(0.00) @db.Decimal(10, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  job_cards          JobCard[]         @relation("WorkerJobCards")
  invoices           Invoice[]         @relation("CashierInvoices")
  expenses           Expense[]         @relation("UserExpenses")
  register_sessions  RegisterSession[] @relation("UserRegisterSessions")
  worker_assignments JobCardWorker[]   @relation("WorkerAssignments")

  @@map("users")
}

model Vehicle {
  id                  String   @id @default(uuid())
  registration_number String   @unique @db.VarChar(30)
  normalized_plate    String?  @db.VarChar(30)
  make                String?  @db.VarChar(50)
  model               String?  @db.VarChar(50)
  visits              Int      @default(0)
  customer_name       String?  @default("Walk-in Customer") @db.VarChar(100)
  customer_phone      String?  @db.VarChar(25)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  job_cards JobCard[]
  deposits  CustomerDeposit[]

  @@index([normalized_plate])
  @@map("vehicles")
}

model Service {
  id                         String          @id @default(uuid())
  name                       String          @db.VarChar(100)
  category                   ServiceCategory @default(Wash)
  price                      Decimal         @db.Decimal(10, 2)
  estimated_time             Int // In minutes
  is_active                  Boolean         @default(true)
  linked_inventory_id        String?
  linked_inventory           Inventory?      @relation(fields: [linked_inventory_id], references: [id], onDelete: SetNull)
  inventory_deduction_amount Decimal?        @db.Decimal(10, 2)
  created_at                 DateTime        @default(now())
  updated_at                 DateTime        @updatedAt

  job_card_items      JobCardService[]
  service_inventories ServiceInventory[]

  @@map("services")
}

model JobCard {
  id                String        @id @default(uuid())
  ticket_number     String?       @unique @db.VarChar(30)
  vehicle_id        String
  vehicle           Vehicle       @relation(fields: [vehicle_id], references: [id], onDelete: Restrict)
  customer_name     String?       @db.VarChar(100)
  worker_id         String?
  worker            User?         @relation("WorkerJobCards", fields: [worker_id], references: [id], onDelete: SetNull)
  status            JobCardStatus @default(QUEUED)
  assigned_location WorkLocation?
  assigned_team     String?       @db.VarChar(50)
  started_at        DateTime?
  completed_at      DateTime?
  intake_notes      String?       @db.Text
  photos_url        String?       @db.Text
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  services           JobCardService[]
  assigned_workers   JobCardWorker[]
  invoice            Invoice?
  media              VehicleMedia[]
  material_issuances MaterialIssuance[]

  @@map("job_cards")
}

model JobCardWorker {
  id          String   @id @default(uuid())
  job_card_id String
  job_card    JobCard  @relation(fields: [job_card_id], references: [id], onDelete: Cascade)
  user_id     String
  user        User     @relation("WorkerAssignments", fields: [user_id], references: [id], onDelete: Cascade)
  assigned_at DateTime @default(now())

  @@unique([job_card_id, user_id])
  @@map("job_card_workers")
}

model VehicleMedia {
  id          String           @id @default(uuid())
  job_card_id String
  job_card    JobCard          @relation(fields: [job_card_id], references: [id], onDelete: Cascade)
  file_path   String
  type        VehicleMediaType @default(BEFORE)
  notes       String?          @db.Text
  uploaded_at DateTime         @default(now())

  @@map("vehicle_media")
}

model JobCardService {
  id            String  @id @default(uuid())
  job_card_id   String
  job_card      JobCard @relation(fields: [job_card_id], references: [id], onDelete: Cascade)
  service_id    String
  service       Service @relation(fields: [service_id], references: [id], onDelete: Restrict)
  price_charged Decimal @db.Decimal(10, 2)

  @@unique([job_card_id, service_id])
  @@map("job_card_services")
}

model Invoice {
  id              String        @id @default(uuid())
  invoice_number  String?       @unique @db.VarChar(30)
  job_card_id     String        @unique
  job_card        JobCard       @relation(fields: [job_card_id], references: [id], onDelete: Restrict)
  cashier_id      String?
  cashier         User?         @relation("CashierInvoices", fields: [cashier_id], references: [id], onDelete: SetNull)
  total_amount    Decimal       @db.Decimal(10, 2)
  discount_amount Decimal       @default(0.00) @db.Decimal(10, 2)
  paid_amount     Decimal       @default(0.00) @db.Decimal(10, 2)
  cash_tendered   Decimal?      @db.Decimal(10, 2)
  change_returned Decimal?      @db.Decimal(10, 2)
  balance_due     Decimal?      @default(0.00) @db.Decimal(10, 2)
  payment_method  PaymentMethod @default(Cash)
  status          String        @default("PAID") @db.VarChar(20)
  created_at      DateTime      @default(now())

  refunds  Refund[]
  payments Payment[]
  deposits CustomerDeposit[]

  @@map("invoices")
}

model BankAccount {
  id              String   @id @default(uuid())
  bank_name       String   @db.VarChar(100)
  account_title   String   @db.VarChar(100)
  account_number  String   @db.VarChar(50)
  current_balance Decimal  @default(0.00) @db.Decimal(12, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  payments       Payment[]
  transfers_from LedgerTransfer[] @relation("FromBankAccount")
  transfers_to   LedgerTransfer[] @relation("ToBankAccount")

  @@map("bank_accounts")
}

model Payment {
  id              String        @id @default(uuid())
  invoice_id      String
  invoice         Invoice       @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(10, 2)
  payment_method  PaymentMethod @default(Cash)
  bank_account_id String?
  bank_account    BankAccount?  @relation(fields: [bank_account_id], references: [id], onDelete: SetNull)
  tender_amount   Decimal?      @db.Decimal(10, 2)
  change_amount   Decimal?      @db.Decimal(10, 2)
  recorded_by_id  String?
  notes           String?       @db.Text
  created_at      DateTime      @default(now())

  @@map("payments")
}

model CustomerDeposit {
  id                    String        @id @default(uuid())
  vehicle_id            String?
  vehicle               Vehicle?      @relation(fields: [vehicle_id], references: [id], onDelete: SetNull)
  customer_name         String        @db.VarChar(100)
  customer_phone        String?       @db.VarChar(30)
  amount                Decimal       @db.Decimal(10, 2)
  payment_method        PaymentMethod @default(Cash)
  status                DepositStatus @default(ACTIVE)
  notes                 String?       @db.Text
  applied_to_invoice_id String?
  applied_to_invoice    Invoice?      @relation(fields: [applied_to_invoice_id], references: [id], onDelete: SetNull)
  created_at            DateTime      @default(now())
  applied_at            DateTime?

  @@map("customer_deposits")
}

model LedgerTransfer {
  id                   String       @id @default(uuid())
  transfer_type        String       @default("CASH_TO_BANK") @db.VarChar(30)
  from_account         AccountType  @default(Cash_Drawer)
  to_account           AccountType  @default(Main_Bank)
  from_bank_account_id String?
  from_bank_account    BankAccount? @relation("FromBankAccount", fields: [from_bank_account_id], references: [id], onDelete: SetNull)
  to_bank_account_id   String?
  to_bank_account      BankAccount? @relation("ToBankAccount", fields: [to_bank_account_id], references: [id], onDelete: SetNull)
  amount               Decimal      @db.Decimal(12, 2)
  transferred_by_id    String?
  notes                String?      @db.Text
  created_at           DateTime     @default(now())

  @@map("ledger_transfers")
}

model MaterialIssuance {
  id              String    @id @default(uuid())
  job_card_id     String
  job_card        JobCard   @relation(fields: [job_card_id], references: [id], onDelete: Cascade)
  inventory_id    String
  inventory       Inventory @relation(fields: [inventory_id], references: [id], onDelete: Restrict)
  quantity_issued Decimal   @db.Decimal(10, 2)
  issued_by_id    String?
  notes           String?   @db.Text
  created_at      DateTime  @default(now())

  @@map("material_issuances")
}

model Refund {
  id                String   @id @default(uuid())
  invoice_id        String
  invoice           Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Restrict)
  amount            Decimal  @db.Decimal(10, 2)
  reason            String   @db.Text
  authorized_by_pin String   @db.VarChar(10)
  created_at        DateTime @default(now())

  @@map("refunds")
}

model AlertOutbox {
  id            String       @id @default(uuid())
  type          String       @default("TELEGRAM")
  payload       Json
  status        OutboxStatus @default(PENDING)
  error_message String?      @db.Text
  created_at    DateTime     @default(now())
  processed_at  DateTime?

  @@map("alert_outbox")
}

model Inventory {
  id                  String   @id @default(uuid())
  item_name           String   @db.VarChar(100)
  unit_type           UnitType @default(Unit)
  current_stock       Decimal  @db.Decimal(10, 2)
  cost_per_unit       Decimal  @db.Decimal(10, 2)
  low_stock_threshold Decimal  @default(10.00) @db.Decimal(10, 2)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  services            Service[]
  service_inventories ServiceInventory[]
  material_issuances  MaterialIssuance[]

  @@map("inventory")
}

model Expense {
  id             String        @id @default(uuid())
  category       String        @db.VarChar(100)
  amount         Decimal       @db.Decimal(10, 2)
  payment_method PaymentMethod @default(Cash)
  description    String?       @db.Text
  recorded_by_id String?
  recorded_by    User?         @relation("UserExpenses", fields: [recorded_by_id], references: [id], onDelete: SetNull)
  created_at     DateTime      @default(now())

  @@map("expenses")
}

model Ledger {
  id              String      @id @default(uuid())
  account_type    AccountType @unique
  current_balance Decimal     @default(0.00) @db.Decimal(12, 2)
  last_updated    DateTime    @default(now()) @updatedAt

  @@map("ledger")
}

model RegisterSession {
  id                    String         @id @default(uuid())
  opened_at             DateTime       @default(now())
  closed_at             DateTime?
  opened_by_user_id     String?
  opened_by             User?          @relation("UserRegisterSessions", fields: [opened_by_user_id], references: [id], onDelete: SetNull)
  starting_cash         Decimal        @db.Decimal(12, 2)
  expected_closing_cash Decimal?       @db.Decimal(12, 2)
  actual_counted_cash   Decimal?       @db.Decimal(12, 2)
  variance              Decimal?       @db.Decimal(12, 2)
  status                RegisterStatus @default(OPEN)
  notes                 String?        @db.Text
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  @@map("register_sessions")
}

model ServiceInventory {
  id               String    @id @default(uuid())
  service_id       String
  service          Service   @relation(fields: [service_id], references: [id], onDelete: Cascade)
  inventory_id     String
  inventory        Inventory @relation(fields: [inventory_id], references: [id], onDelete: Cascade)
  deduction_amount Decimal   @db.Decimal(10, 2)
  created_at       DateTime  @default(now())

  @@unique([service_id, inventory_id])
  @@map("service_inventory")
}

model PartnerEquity {
  id                String   @id @default(uuid())
  partner_name      String   @db.VarChar(100)
  equity_percentage Decimal  @db.Decimal(5, 2)
  phone             String?  @db.VarChar(30)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  transactions PartnerTransaction[]

  @@map("partner_equity")
}

model PartnerTransaction {
  id             String        @id @default(uuid())
  partner_id     String
  partner        PartnerEquity @relation(fields: [partner_id], references: [id], onDelete: Cascade)
  type           PartnerTxType
  amount         Decimal       @db.Decimal(12, 2)
  payment_method PaymentMethod @default(Cash)
  notes          String?       @db.Text
  date           DateTime      @default(now())
  created_at     DateTime      @default(now())

  @@map("partner_transactions")
}

model AuditLog {
  id                   String   @id @default(uuid())
  action               String   @db.VarChar(100)
  description          String   @db.Text
  performed_by_user_id String?  @db.VarChar(100)
  performed_by_name    String?  @db.VarChar(100)
  metadata             Json?
  created_at           DateTime @default(now())

  @@map("audit_logs")
}

model BusinessBranding {
  id                String   @id @default(uuid())
  business_name     String   @default("DF PRO Car Wash & Detailing Center") @db.VarChar(150)
  tagline           String?  @db.VarChar(150)
  address           String?  @db.Text
  phone             String?  @db.VarChar(50)
  email             String?  @db.VarChar(100)
  ntn_number        String?  @db.VarChar(50)
  logo_url          String?  @db.Text
  logo_size         Int      @default(120)
  loyalty_threshold Int      @default(5)
  invoice_template  String   @default("CLASSIC_THERMAL") @db.VarChar(50)
  token_template    String   @default("STANDARD_BOX") @db.VarChar(50)
  vehicle_makes     String?  @db.Text
  show_business_name Boolean @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("business_branding")
}

{
  "name": "carwash-management-system",
  "version": "1.0.0",
  "description": "Local-first Car Wash & Detailing Management System with immutable financial ledger",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -n \"API,UI\" -c \"cyan,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon src/server.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:alerts": "node scripts/test-alerts.js",
    "simulate": "node scripts/simulate-system.js"
  },
  "keywords": [
    "carwash",
    "pos",
    "ledger",
    "prisma",
    "express"
  ],
  "author": "Muhammad Uzair",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-telegram-bot-api": "^2.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}

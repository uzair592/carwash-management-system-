{
  "name": "carwash-management-system",
  "version": "1.0.0",
  "description": "Local-first Car Wash & Detailing Management System with immutable financial ledger",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -n \"API,UI\" -c \"cyan,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon src/server.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build:ui": "npm --prefix client install && npm --prefix client run build",
    "prod:start": "pm2 start ecosystem.config.js",
    "prod:stop": "pm2 stop ecosystem.config.js",
    "prod:restart": "pm2 restart ecosystem.config.js",
    "prod:logs": "pm2 logs",
    "prod:status": "pm2 status",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "test:alerts": "node scripts/test-alerts.js",
    "test:camera": "node scripts/test-camera.js",
    "simulate": "node scripts/simulate-system.js",
    "verify:readiness": "node scripts/verify-shop-readiness.js",
    "test:integrity": "node --test scripts/test-shop-integrity.cjs",
    "test:ui": "node scripts/test-professional-ui.cjs",
    "backup:shop": "node scripts/backup-shop.js",
    "restore:shop": "node scripts/restore-shop.js",
    "prisma:deploy": "prisma migrate deploy",
    "test:migrations": "node scripts/test-migrations.cjs",
    "printer:self-test": "node scripts/printer-self-test.cjs",
    "test:backup-restore": "node --test scripts/test-backup-restore.cjs",
    "test:startup": "node --test scripts/test-shop-startup.cjs"
  },
  "keywords": [
    "carwash",
    "pos",
    "ledger",
    "prisma",
    "express"
  ],
  "author": "Muhammad Uzair",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^2.1.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.9",
    "pm2": "^7.0.4",
    "prisma": "^5.22.0",
    "serve": "^14.2.6",
    "@electric-sql/pglite": "^0.5.8"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
